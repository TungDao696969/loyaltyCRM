model RewardCatalog {
  reward_id              Int       @id @default(autoincrement())
  reward_name            String    @db.VarChar(100)
  required_points        Int
  reward_type            String    @db.VarChar(20) // e.g., "VOUCHER", "GIFT"
  voucher_discount_value Decimal?  @db.Decimal(15, 2)
  is_active              Boolean?  @default(true)
  created_at             DateTime? @default(now()) @db.Timestamp(6)
  updated_at             DateTime? @updatedAt @db.Timestamp(6)

  @@map("reward_catalogs")
}

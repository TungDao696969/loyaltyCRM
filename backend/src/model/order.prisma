model Order {
  order_id       BigInt      @id @default(autoincrement())
  customer_id    BigInt
  invoice_code   String      @unique @db.VarChar(50) // Mã hóa đơn (VD: INV-001)
  total_amount   Decimal     @db.Decimal(15, 2)      // Tổng tiền đơn hàng
  status         String      @default("completed") @db.VarChar(20) // completed, cancelled
  created_at     DateTime?   @default(now()) @db.Timestamp(6)
  
  // Liên kết
  customer       Customer    @relation(fields: [customer_id], references: [customer_id])
  items          OrderItem[] // 1 Hóa đơn có nhiều chi tiết
  @@map("orders")
}